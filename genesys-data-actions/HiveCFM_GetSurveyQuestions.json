{
  "actionType": "custom",
  "config": {
    "request": {
      "headers": {
        "x-Api-Key": "${input.API_KEY}"
      },
      "requestTemplate": "${input.rawRequest}",
      "requestType": "GET",
      "requestUrlTemplate": "https://${input.HOST}/api/v1/client/${input.ENVIRONMENT_ID}/ivr/${input.SURVEY_ID}?lang=${input.LANGUAGE}"
    },
    "response": {
      "successTemplate": "${rawResult}",
      "translationMap": {},
      "translationMapDefaults": {}
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "properties": {
          "API_KEY": {
            "description": "HiveCFM API key",
            "type": "string"
          },
          "ENVIRONMENT_ID": {
            "description": "HiveCFM environment ID",
            "type": "string"
          },
          "HOST": {
            "description": "HiveCFM hostname (e.g. hivecfm.xcai.io)",
            "type": "string"
          },
          "LANGUAGE": {
            "description": "Language code: ar, en, etc.",
            "type": "string"
          },
          "SURVEY_ID": {
            "description": "Survey ID to fetch",
            "type": "string"
          }
        },
        "required": ["HOST", "ENVIRONMENT_ID", "SURVEY_ID", "API_KEY", "LANGUAGE"],
        "title": "GetSurveyQuestions Input",
        "type": "object"
      }
    },
    "output": {
      "successSchema": {
        "properties": {
          "questions": { "items": { "type": "object" }, "type": "array" },
          "survey": { "type": "object" }
        },
        "title": "GetSurveyQuestions Output",
        "type": "object"
      }
    }
  },
  "integrationType": "custom-rest-actions",
  "name": "HiveCFM_GetSurveyQuestions",
  "secure": false
}
