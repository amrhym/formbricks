{
  "actionType": "custom",
  "config": {
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-Api-Key": "${input.API_KEY}"
      },
      "requestTemplate": "{ \"callId\": \"${input.CALL_ID}\", \"callerNumber\": \"${input.CALLER_NUMBER}\", \"language\": \"${input.LANGUAGE}\", \"answers\": ${input.ANSWERS_JSON}, \"finished\": ${input.FINISHED} }",
      "requestType": "POST",
      "requestUrlTemplate": "https://${input.HOST}/api/v1/client/${input.ENVIRONMENT_ID}/ivr/${input.SURVEY_ID}/responses"
    },
    "response": {
      "successTemplate": "${rawResult}",
      "translationMap": {},
      "translationMapDefaults": {}
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "properties": {
          "ANSWERS_JSON": {
            "description": "JSON answers: {\"q1\": 8, \"q2\": \"1\"}",
            "type": "string"
          },
          "API_KEY": {
            "description": "HiveCFM API key",
            "type": "string"
          },
          "CALLER_NUMBER": {
            "description": "Caller phone number",
            "type": "string"
          },
          "CALL_ID": {
            "description": "Unique call identifier",
            "type": "string"
          },
          "ENVIRONMENT_ID": {
            "description": "HiveCFM environment ID",
            "type": "string"
          },
          "FINISHED": {
            "description": "true if survey complete",
            "type": "boolean"
          },
          "HIDDEN_FIELDS_JSON": {
            "description": "JSON hidden fields: {\"branchName\": \"Riyadh\"}",
            "type": "string"
          },
          "HOST": {
            "description": "HiveCFM hostname (e.g. hivecfm.xcai.io)",
            "type": "string"
          },
          "LANGUAGE": {
            "description": "Language code: ar, en, etc.",
            "type": "string"
          },
          "SURVEY_ID": {
            "description": "Survey ID",
            "type": "string"
          }
        },
        "required": [
          "HOST",
          "ENVIRONMENT_ID",
          "SURVEY_ID",
          "API_KEY",
          "CALL_ID",
          "ANSWERS_JSON",
          "FINISHED",
          "LANGUAGE"
        ],
        "title": "SubmitAnswer Input",
        "type": "object"
      }
    },
    "output": {
      "successSchema": {
        "properties": {
          "message": { "type": "string" },
          "responseId": { "type": "string" }
        },
        "title": "SubmitAnswer Output",
        "type": "object"
      }
    }
  },
  "integrationType": "custom-rest-actions",
  "name": "HiveCFM_SubmitAnswer",
  "secure": false
}
